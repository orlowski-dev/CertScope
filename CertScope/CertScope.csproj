<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Linux deployment -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" Version="0.8.1" />
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
  </ItemGroup>

  <!-- Blueprint configuration -->
  <PropertyGroup>
    <BlueprintSourceDir>$(MSBuildProjectDirectory)/Resources</BlueprintSourceDir>
    <BlueprintOutputDir>$(IntermediateOutputPath)blueprint/</BlueprintOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <BlueprintInput Include="Resources/**/*.blp">
      <OutputFile>$(BlueprintOutputDir)%(RecursiveDir)%(Filename).ui</OutputFile>
    </BlueprintInput>

    <GResourceInput Include="Resources/**/*.css" />
    <GResourceInput Include="Resources/**/*.svg" />
    <GResourceInput Include="Resources/**/*.png" />
  </ItemGroup>

  <!-- GResource configuration -->
  <PropertyGroup>
    <ResourcesFileName>io.github.orlowski_dev.CertScope.gresource</ResourcesFileName>
    <GResourceSourceDir>$(MSBuildProjectDirectory)/Resources</GResourceSourceDir>
    <GResourceManifest>$(GResourceSourceDir)/io.github.orlowski_dev.CertScope.gresource.xml</GResourceManifest>
  </PropertyGroup>

  <!-- Compile Blueprint files incrementally -->
  <Target
    Name="CompileBlueprints"
    Inputs="%(BlueprintInput.FullPath)"
    Outputs="%(BlueprintInput.OutputFile)"
  >
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(BlueprintInput.OutputFile)'))" />

    <Exec Command="blueprint-compiler compile --output &quot;%(BlueprintInput.OutputFile)&quot; &quot;%(BlueprintInput.FullPath)&quot;" />
  </Target>

  <!-- Compile GResource after Blueprint -->
  <Target
    Name="CompileGResources"
    BeforeTargets="AssignTargetPaths"
    DependsOnTargets="CompileBlueprints"
    Inputs="$(GResourceManifest);@(GResourceInput);@(BlueprintInput);@(BlueprintInput->'%(OutputFile)')"
    Outputs="$(IntermediateOutputPath)$(ResourcesFileName)"
  >
    <MakeDir Directories="$(IntermediateOutputPath)" />

    <Exec Command="glib-compile-resources --sourcedir=&quot;$(BlueprintOutputDir)&quot; --sourcedir=&quot;$(GResourceSourceDir)&quot; --target=&quot;$(IntermediateOutputPath)$(ResourcesFileName)&quot; &quot;$(GResourceManifest)&quot;" />
  </Target>

  <!-- Copy GResource to build output -->
  <Target
    Name="RegisterGResources"
    BeforeTargets="AssignTargetPaths"
    DependsOnTargets="CompileGResources"
  >
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)$(ResourcesFileName)">
        <TargetPath>$(ResourcesFileName)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
  </Target>

  <!-- Include GResource in dotnet publish -->
  <Target
    Name="PublishGResources"
    AfterTargets="ComputeFilesToPublish"
    DependsOnTargets="CompileGResources"
  >
    <ItemGroup>
      <ResolvedFileToPublish Include="$(IntermediateOutputPath)$(ResourcesFileName)">
        <RelativePath>$(ResourcesFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Gettext configuration -->
  <PropertyGroup>
    <TranslationDomain>io.github.orlowski_dev.CertScope</TranslationDomain>
    <TranslationsSourceDir>$(MSBuildProjectDirectory)/po</TranslationsSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source translation files must not be copied to output -->
    <None Remove="po/**/*.po;po/**/*.pot" />

    <!-- Translation sources and generated outputs -->
    <Translation Include="$(TranslationsSourceDir)/*.po">
      <MoOutput>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/locale/%(Filename)/LC_MESSAGES/$(TranslationDomain).mo</MoOutput>
      <TargetPath>locale/%(Filename)/LC_MESSAGES/$(TranslationDomain).mo</TargetPath>
    </Translation>
  </ItemGroup>

  <!-- Compile translations incrementally -->
  <Target
    Name="CompileTranslations"
    Inputs="@(Translation)"
    Outputs="@(Translation->'%(MoOutput)')"
  >
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(Translation.MoOutput)'))" />

    <Exec Command="msgfmt --check --output-file=&quot;%(Translation.MoOutput)&quot; &quot;%(Translation.FullPath)&quot;" />
  </Target>

  <!-- Register generated MO files -->
  <Target
    Name="RegisterTranslations"
    BeforeTargets="AssignTargetPaths"
    DependsOnTargets="CompileTranslations"
  >
    <ItemGroup>
      <None
        Include="@(Translation->'%(MoOutput)')"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>
</Project>
