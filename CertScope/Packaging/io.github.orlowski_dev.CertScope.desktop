[Desktop Entry]
Type=Application
Name=CertScope
GenericName=Certificate Manager
GenericName[pl]=Menedżer certyfikatów
Comment=Manage and inspect X.509 certificates and diagnose TLS connections
Comment[pl]=Zarządzanie i analiza certyfikatów X.509 oraz diagnostyka połączeń TLS
Exec=CertScope
Icon=io.github.orlowski_dev.CertScope
Terminal=false
